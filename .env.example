# Copy to .env and keep it local. Never commit real credentials.
IVINS_REGISTRY_HOST_ROOT=../iVINS-mav-dataset
IVINS_RAW_HOST_ROOT=/absolute/path/to/DataSets
IVINS_IMPORT_HOST_ROOT=/absolute/path/to/readable/import/source/tree
IVINS_BIND_ADDRESS=0.0.0.0
IVINS_PORT=8080
IVINS_API_KEY=replace-with-a-long-random-local-secret

# Optional external resolver credentials:
IVINS_ONEDRIVE_TOKEN=
IVINS_GOOGLE_DRIVE_API_KEY=
IVINS_GOOGLE_DRIVE_TOKEN=
