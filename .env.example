# HTTP listener. Keep 127.0.0.1 when a reverse proxy runs on this host.
DSM_COMPOSE_PROJECT=datasetsmanager-server
DSM_CONTAINER_NAME=datasetsmanager-server
DSM_BIND_ADDRESS=127.0.0.1
DSM_PORT=8080
DSM_DATA_HOST_ROOT=F:/Indra/DataSetsManager-runtime/server/var
# All .bag/.zip artifacts are direct children of DSM_DATA_HOST_ROOT/bags.

# Request and container resource limits.
DSM_MAX_UPLOAD_BYTES=53687091200
DSM_MAX_JSON_BYTES=65536
DSM_REQUESTS_PER_MINUTE=120
DSM_AUTH_ATTEMPTS_PER_MINUTE=240
DSM_AUTH_FAILURES_PER_MINUTE=20
DSM_DOWNLOADS_PER_MINUTE=30
DSM_PUBLIC_REQUESTS_PER_MINUTE=120
DSM_MEMORY_LIMIT=1g
DSM_CPU_LIMIT=1.0
DSM_PIDS_LIMIT=128

# IVINS_* aliases remain accepted through Backend 4.x. DSM_* always wins.

# API keys are intentionally absent. Generate them on the server with:
# docker compose run --rm --no-deps server python api_keys.py create --name initial-admin --role admin
