# HTTP listener. Keep 127.0.0.1 when a reverse proxy runs on this host.
IVINS_BIND_ADDRESS=127.0.0.1
IVINS_PORT=8080
IVINS_DATA_HOST_ROOT=./var
# All .bag/.zip artifacts are direct children of IVINS_DATA_HOST_ROOT/bags.

# Request and container resource limits.
IVINS_MAX_UPLOAD_BYTES=53687091200
IVINS_MAX_JSON_BYTES=65536
IVINS_REQUESTS_PER_MINUTE=120
IVINS_AUTH_ATTEMPTS_PER_MINUTE=240
IVINS_AUTH_FAILURES_PER_MINUTE=20
IVINS_MEMORY_LIMIT=1g
IVINS_CPU_LIMIT=1.0
IVINS_PIDS_LIMIT=128

# API keys are intentionally absent. Generate them on the server with:
# docker compose run --rm --no-deps server python api_keys.py create --name initial-admin --role admin
