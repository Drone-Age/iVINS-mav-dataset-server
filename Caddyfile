{
	admin off
}

{$DSM_PUBLIC_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy server:8080
	# Access logging stays disabled so bearer credentials, ticket query values,
	# and private artifact paths cannot enter the proxy journal.
}
