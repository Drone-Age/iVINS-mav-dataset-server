{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DataSetsManager/server/releases/download/schema-distribution-v2.0.0/package-manifest.schema.json",
  "title": "DataSetsManager Distribution Package Manifest",
  "type": "object",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "distribution",
    "package_format",
    "platform",
    "components",
    "compatibility",
    "entrypoints",
    "data"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "DataSetsManager Server"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "package_format": {"enum": ["docker-bundle", "windows-portable", "windows-msi"]},
    "platform": {
      "type": "object",
      "required": ["os", "architecture"],
      "properties": {
        "os": {"type": "string"},
        "architecture": {"type": "string"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "process", "distribution"],
      "properties": {
        "backend": {"$ref": "#/$defs/semver"},
        "frontend": {"$ref": "#/$defs/semver"},
        "process": {"$ref": "#/$defs/semver"},
        "distribution": {"$ref": "#/$defs/semver"}
      }
    },
    "compatibility": {"type": "object", "minProperties": 1},
    "image": {
      "type": "object",
      "required": ["reference", "archive", "image_id"],
      "properties": {
        "reference": {"type": "string"},
        "archive": {"type": "string"},
        "image_id": {"type": "string"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "service"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1}
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["install", "update", "rollback", "verify"],
      "properties": {
        "install": {"type": "string"},
        "update": {"type": "string"},
        "rollback": {"type": "string"},
        "verify": {"type": "string"}
      }
    },
    "data": {
      "type": "object",
      "required": ["included", "persistent", "default_root"],
      "properties": {
        "included": {"const": false},
        "persistent": {"const": true},
        "default_root": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"package_format": {"const": "docker-bundle"}}},
      "then": {"required": ["image"]}
    },
    {
      "if": {"properties": {"package_format": {"enum": ["windows-portable", "windows-msi"]}}},
      "then": {"required": ["runtime"]}
    }
  ]
}
